{
  "name": "angelic-angel",
  "version": "0.1.0",
  "description": "Twitter Web Push Receiver in TypeScript",
  "type": "module",
  "bin": {
    "angelic-angel": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc",
    "typecheck:core": "tsc --project tsconfig.core.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "twitter",
    "webpush",
    "autopush",
    "ece"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^7.3.2",
    "commander": "^13.1.0",
    "ora": "^8.2.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "smol-toml": "^1.3.1",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/ws": "^8.5.14",
    "http_ece": "^1.2.0",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
